# --- Supabase (obligatorio para persistencia real y multi-dispositivo) ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# URL pública de la app (para enlaces de recuperación de contraseña y confirmación de email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demo local: si es "true" y NO hay Supabase configurado, la app funciona
# sin backend guardando los datos SOLO en este navegador (para probarla).
# Déjalo en "false" en producción.
NEXT_PUBLIC_ENABLE_DEMO=true
